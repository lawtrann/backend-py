# ===========================
# Required
# ===========================
SECRET_KEY=local-dev-secret-change-in-production

# ===========================
# Optional (defaults shown)
# ===========================
# DEBUG=false

# Database
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=example
# POSTGRES_DB=backend
# DB_HOST=localhost
# DB_PORT=15432
# DATABASE_URL=              # auto-built from above if not set

# Database Connection Pool
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_POOL_PRE_PING=true

# Server
# API_PORT=8000

# Application
# PROJECT_NAME=Backend API

# Authentication
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS & Security
# CORS_ORIGINS=[]
# COOKIE_SECURE=false

# MinIO / Object Storage
# MINIO_ENDPOINT=localhost:9080
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_SECURE=false
# MINIO_DEFAULT_BUCKET=uploads
# MINIO_PRESIGNED_URL_EXPIRY_SECONDS=3600
